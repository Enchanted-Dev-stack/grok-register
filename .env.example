# Captcha: auto (YesCaptcha if YESCAPTCHA_KEY is set, else Theyka local API)
# CAPTCHA_SOLVER="local"
# CAPTCHA_SOLVER="manual"   # real /sign-up page; you click Turnstile
# Local solver: Theyka/Turnstile-Solver (https://github.com/Theyka/Turnstile-Solver)
# TURNSTILE_API="http://127.0.0.1:5000"
# TURNSTILE_BROWSER="msedge"
YESCAPTCHA_KEY="your_yescaptcha_key"

# Email provider: gptmail / luckmail / mailnest
EMAIL_PROVIDER="gptmail"

# Registration thread count (optional)
THREADS="1"

# LuckMail (only when EMAIL_PROVIDER=luckmail)
# LUCKMAIL_BASE_URL defaults to https://mails.luckyous.com; override only for a different host
# LUCKMAIL_BASE_URL="https://mails.luckyous.com"
LUCKMAIL_API_KEY="your_luckmail_api_key"
LUCKMAIL_API_SECRET=""
LUCKMAIL_USE_HMAC="false"
LUCKMAIL_PROJECT_CODE="grok"
LUCKMAIL_EMAIL_TYPE="ms_imap"
LUCKMAIL_DOMAIN="outlook.com"

# MailNest (only when EMAIL_PROVIDER=mailnest)
# Get API key: https://mailnest.top/account
# Get project code: https://mailnest.top/buy-email (default x-ai001)
MAILNEST_API_KEY="your_mailnest_api_key"
MAILNEST_PROJECT_CODE="x-ai001"

# Optional HTTP proxy. Leave unset to connect directly (no Clash/local proxy required).
# GROK_PROXY="http://127.0.0.1:7897"
# Tor Browser SOCKS (or pass --tor). Start Tor Browser first; default port 9150.
# GROK_PROXY="socks5h://127.0.0.1:9150"
# TOR_PROXY="socks5h://127.0.0.1:9150"

# Phone IP rotation via ADB (USB debugging + USB tethering).
# --adb-rotate --adb-every 3  → 3 parallel signups per IP, then cycle.
# Install platform-tools so `adb` is on PATH, or set ADB=C:\path\to\adb.exe
# ADB_SERIAL=""
